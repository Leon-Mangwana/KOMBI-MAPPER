# Base URL of the Kombi API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Basemap. Leave both unset to run with a blank background — the map still
# shows your position and the live trace, it just has no map underneath.
#
# Either point at a self-hosted MapLibre style JSON...
# VITE_BASEMAP_STYLE_URL=http://localhost:8080/styles/protomaps/style.json
#
# ...or at a Protomaps .pmtiles archive, which is loaded over the pmtiles://
# protocol. The style URL wins if both are set.
# The same archive the web map uses — cutting and hosting one is documented in
# ../infra/README.md#basemap-tiles
# VITE_PMTILES_URL=https://tiles.example.org/harare.pmtiles

# Initial map view, used until the first GPS fix arrives. Defaults to Harare.
VITE_MAP_CENTER_LON=31.0522
VITE_MAP_CENTER_LAT=-17.8292
VITE_MAP_ZOOM=12
