# Base URL of the Kombi API (no trailing slash). The map reads /routes and
# /stops from here, and by default links to its /gtfs.zip.
VITE_API_BASE_URL=http://localhost:8000

# Where the GTFS feed is downloaded from. Leave unset in development, where the
# API serves the file the pipeline wrote.
#
# Set this when the API and the pipeline run on different machines — the API
# cannot serve a file it does not have. Export into this app's public/ folder
# instead and serve it from the same origin as the map:
#
#   cd pipeline && python gtfs.py -o ../web/public/gtfs.zip
#
# VITE_GTFS_URL=/gtfs.zip

# Basemap. Leave both unset to run with a blank background — the routes and
# stops still draw, they just have no map underneath.
#
# Either point at a self-hosted MapLibre style JSON...
# VITE_BASEMAP_STYLE_URL=http://localhost:8080/styles/protomaps/style.json
#
# ...or at a Protomaps .pmtiles archive, which is loaded over the pmtiles://
# protocol. The style URL wins if both are set.
# VITE_PMTILES_URL=http://localhost:8080/harare.pmtiles

# Fallback view, used only when there are no routes to frame. Defaults to Harare.
VITE_MAP_CENTER_LON=31.0522
VITE_MAP_CENTER_LAT=-17.8292
VITE_MAP_ZOOM=11
