# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kombi

# Used only by the pytest suite (tests/conftest.py).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kombi_test

# Browser origins allowed to call the API, comma-separated. Must include the
# origins the capture PWA and the web map are served from, or their requests
# are blocked by CORS. Defaults: capture on 5173 (preview 4173), web on 5174
# (preview 4174).
# When testing capture on a phone through a tunnel, add that URL here too,
# e.g. https://something.trycloudflare.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4174

# Shared secret for the operator-only endpoints, sent as an X-Admin-Token
# header. Guards GET /traces/{id}, which returns a contributor's raw
# timestamped ride and must not be public.
#
# Leaving this unset does NOT open those endpoints — it disables them (503).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# --- Ingest limits (POST /traces is open to anyone; these bound it) ---------
# Defaults shown; all optional.
# MAX_TRACE_POINTS=20000        # ~5.5 hours at 1 Hz
# MAX_UPLOAD_BYTES=8000000      # a full-length trace is ~2.5 MB of JSON
# UPLOADS_PER_MINUTE=6
# UPLOADS_PER_HOUR=40

# Read the client address from X-Forwarded-For. Leave on behind a platform
# proxy (Render, Fly, a CDN) or every request looks like it came from the
# proxy. Turn OFF when the API is exposed directly — the header is then written
# by the caller.
# TRUST_PROXY_HEADERS=true

# The GTFS feed served at GET /gtfs.zip. Built by pipeline/gtfs.py — the API
# only serves the file. Defaults to the pipeline's own default output path,
# resolved relative to this repository; set it when the two do not share a
# filesystem in the obvious way.
# GTFS_PATH=../pipeline/gtfs_out/gtfs.zip
