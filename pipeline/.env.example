# Pipeline configuration. Copy to .env; .env is gitignored because it holds a
# live database password. Every value has a default in config.py, so an empty
# file works against the local docker-compose stack.

# The API's database. The pipeline is a batch job an operator runs, so it
# connects directly rather than through the API; only trace *uploads* go over
# HTTP. For a hosted database (Supabase, Neon) use the psycopg driver, request
# TLS, and percent-encode any `@` or `%` in the password (`@` -> %40).
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kombi

# OSRM, for map matching. See ../infra/README.md and ../infra/build-osrm.sh.
# With OSRM unreachable, process.py aborts and leaves traces `uploaded`;
# seed_demo.py --fake-match is the only path that skips it.
OSRM_URL=http://localhost:5000

# Where gtfs.py writes the feed. The API serves this same path (GTFS_PATH in
# api/.env) when both run on one machine; for the split deployment export into
# the web app instead:  python gtfs.py -o ../web/public/gtfs.zip
GTFS_PATH=gtfs_out/gtfs.zip

# agency.txt. There is no agency behind an informal network, so the publisher
# of the feed is the agency. The defaults are valid GTFS placeholders; set the
# name and URL before publishing a feed anyone else will load.
GTFS_AGENCY_ID=kombi
GTFS_AGENCY_NAME=Kombi Route Mapper
GTFS_AGENCY_URL=https://kombi.example.org
GTFS_AGENCY_LANG=en
GTFS_AGENCY_TIMEZONE=Africa/Harare
